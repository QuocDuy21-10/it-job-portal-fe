# Origin of the NestJS backend: no path, no trailing slash.
# The API is served at <origin>/api/v1 and images at <origin>/images.
# Required in production (the build fails without it).
NEXT_PUBLIC_API_URL=http://localhost:8081

# Public URL of this frontend (canonical URLs, sitemap, Open Graph). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth web client ID. Optional: Google sign-in is disabled without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
